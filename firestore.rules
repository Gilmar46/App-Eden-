rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && (
        request.auth.token.email_verified == true ||
        request.auth.token.firebase.sign_in_provider == 'google.com'
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function getMemberData(uid) {
      return get(
        /databases/$(database)/documents/members/$(uid)
      ).data;
    }

    function getUserType() {
      return isSignedIn() &&
        exists(
          /databases/$(database)/documents/members/$(request.auth.uid)
        )
        ? getMemberData(request.auth.uid).get('userType', 'membro')
        : 'membro';
    }

    function getUserDept() {
      return isSignedIn() &&
        exists(
          /databases/$(database)/documents/members/$(request.auth.uid)
        )
        ? getMemberData(request.auth.uid).get('departmentId', '')
        : '';
    }

    function getAccountGroup() {
      return isSignedIn() &&
        exists(
          /databases/$(database)/documents/memberAccounts/$(request.auth.uid)
        )
        ? get(
            /databases/$(database)/documents/memberAccounts/$(request.auth.uid)
          ).data.get('groupId', '')
        : '';
    }

    function getAccountMemberId() {
      return isSignedIn() &&
        exists(
          /databases/$(database)/documents/memberAccounts/$(request.auth.uid)
        )
        ? get(
            /databases/$(database)/documents/memberAccounts/$(request.auth.uid)
          ).data.get('memberId', '')
        : '';
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'gilmarcoutobrito@gmail.com' ||
        exists(
          /databases/$(database)/documents/admins/$(request.auth.uid)
        ) ||
        getUserType() == 'admin'
      );
    }

    function isLider() {
      return isSignedIn() && (
        getUserType() == 'lider' ||
        isAdmin()
      );
    }

    function isValidMember(data) {
      return data.keys().hasAll([
          'name',
          'role',
          'ministry',
          'status'
        ]) &&
        data.name is string &&
        data.name.size() > 0 &&
        data.name.size() <= 100 &&
        data.role is string &&
        data.role.size() <= 100 &&
        data.ministry is string &&
        data.status is string &&
        (
          !data.keys().hasAny(['userType']) ||
          data.userType in ['admin', 'lider', 'membro']
        );
    }

    function isValidComment(data) {
      return data.keys().hasAll([
          'contentId',
          'userId',
          'userName',
          'text',
          'createdAt'
        ]) &&
        data.userId == request.auth.uid &&
        data.text is string &&
        data.text.size() <= 1000 &&
        data.createdAt == request.time;
    }

    function messageAllowMode(uid) {
      return exists(
        /databases/$(database)/documents/messageSettings/$(uid)
      )
        ? get(
            /databases/$(database)/documents/messageSettings/$(uid)
          ).data.get('allowMode', 'approval')
        : 'approval';
    }

    function hasMessagePermission(ownerUid, targetUid) {
      return exists(
        /databases/$(database)/documents/messagePermissions/$(ownerUid)_$(targetUid)
      );
    }

    function hasMessageBlock(firstUid, secondUid) {
      return exists(
        /databases/$(database)/documents/messageBlocks/$(firstUid)_$(secondUid)
      ) || exists(
        /databases/$(database)/documents/messageBlocks/$(secondUid)_$(firstUid)
      );
    }

    function hasApprovedMessageRequest(fromUid, toUid) {
      return exists(
        /databases/$(database)/documents/messageRequests/$(fromUid)_$(toUid)
      ) &&
      get(
        /databases/$(database)/documents/messageRequests/$(fromUid)_$(toUid)
      ).data.get('status', '') == 'approved';
    }

    function isTwoPersonRoom(data) {
      return data.participants is list &&
        data.participants.size() == 2 &&
        data.participants[0] != data.participants[1];
    }

    function otherRoomParticipant(roomData) {
      return roomData.participants[0] == request.auth.uid
        ? roomData.participants[1]
        : roomData.participants[0];
    }

    function canActivateRoom(roomData) {
      let otherUid = otherRoomParticipant(roomData);

      return messageAllowMode(otherUid) == 'everyone' ||
        hasMessagePermission(otherUid, request.auth.uid) ||
        (
          hasMessagePermission(request.auth.uid, otherUid) &&
          hasApprovedMessageRequest(otherUid, request.auth.uid)
        );
    }

    match /members/{memberId} {
      allow read: if isSignedIn();

      allow create: if (
        isAdmin() ||
        request.auth.uid == memberId
      ) && isValidMember(incoming());

      allow update: if (
        isAdmin() ||
        (
          isLider() &&
          existing().get('departmentId', '') == getUserDept()
        ) ||
        request.auth.uid == memberId
      ) && isValidMember(incoming());

      allow delete: if isAdmin();
    }

    match /announcements/{id} {
      allow read: if isSignedIn();

      allow create: if isLider() && (
        incoming().get('departmentId', '') == getUserDept() ||
        isAdmin()
      );

      allow update, delete: if isLider() && (
        existing().get('departmentId', '') == getUserDept() ||
        isAdmin()
      );
    }

    match /comments/{id} {
      allow read: if isSignedIn();
      allow create: if isVerified() && isValidComment(incoming());

      allow delete: if isAdmin() ||
        (
          isLider() &&
          existing().get('departmentId', '') == getUserDept()
        ) ||
        existing().userId == request.auth.uid;
    }

    match /scales/{id} {
      allow read: if isSignedIn();

      allow create: if isAdmin();

      allow update: if isAdmin() || (
        isSignedIn() &&
        existing().get('published', false) == true &&
        existing().get('publishedGroupId', '') ==
          getAccountGroup() &&
        existing().memberId == getAccountMemberId() &&
        incoming()
          .diff(existing())
          .affectedKeys()
          .hasOnly(['status', 'notes'])
      );

      allow delete: if isAdmin();
    }

    match /prayers/{id} {
      allow read, create: if isSignedIn();

      allow update: if isAdmin() || (
        isSignedIn() &&
        incoming()
          .diff(existing())
          .affectedKeys()
          .hasOnly(['prayerCount'])
      );

      allow delete: if isAdmin() ||
        existing().authorId == request.auth.uid;
    }

    match /devotionals/{id} {
      allow read: if isSignedIn();
      allow create: if isVerified();

      allow update, delete: if isAdmin() ||
        existing().authorId == request.auth.uid;
    }

    match /newsCache/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /newsFeedSources/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /userProfiles/{userId} {
      allow read: if isSignedIn() && (
        request.auth.uid == userId ||
        isAdmin() ||
        isLider()
      );

      allow write: if isSignedIn() && (
        request.auth.uid == userId ||
        isAdmin()
      );
    }

    match /bulletins/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /missions/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /agenda/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /activityLogs/{id} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /config/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /admins/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /financial/{id} {
      allow read: if isAdmin() || (
        isSignedIn() &&
        existing().userId == request.auth.uid
      );

      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /memberAccounts/{accountId} {
      allow read: if isSignedIn();

      allow create, update: if isSignedIn() &&
        request.auth.uid == accountId &&
        incoming().uid == accountId;

      allow delete: if isSignedIn() && (
        request.auth.uid == accountId ||
        isAdmin()
      );
    }

    match /messageSettings/{ownerUid} {
      allow read: if isSignedIn();

      allow create, update: if isSignedIn() &&
        request.auth.uid == ownerUid &&
        incoming().ownerUid == ownerUid &&
        incoming().allowMode in [
          'approval',
          'everyone',
          'nobody'
        ];

      allow delete: if isSignedIn() && (
        request.auth.uid == ownerUid ||
        isAdmin()
      );
    }

    match /messagePermissions/{permissionId} {
      allow read: if isSignedIn() && (
        existing().ownerUid == request.auth.uid ||
        existing().targetUid == request.auth.uid ||
        isAdmin()
      );

      allow create: if isSignedIn() &&
        incoming().ownerUid == request.auth.uid &&
        incoming().targetUid != request.auth.uid &&
        !hasMessageBlock(
          incoming().ownerUid,
          incoming().targetUid
        );

      allow update: if isSignedIn() &&
        existing().ownerUid == request.auth.uid &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().targetUid == existing().targetUid &&
        !hasMessageBlock(
          incoming().ownerUid,
          incoming().targetUid
        );

      allow delete: if isSignedIn() && (
        existing().ownerUid == request.auth.uid ||
        isAdmin()
      );
    }

    match /messageBlocks/{blockId} {
      allow read: if isSignedIn() && (
        existing().ownerUid == request.auth.uid ||
        existing().targetUid == request.auth.uid ||
        isAdmin()
      );

      allow create: if isSignedIn() &&
        incoming().ownerUid == request.auth.uid &&
        incoming().targetUid != request.auth.uid;

      allow update: if isSignedIn() &&
        existing().ownerUid == request.auth.uid &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().targetUid == existing().targetUid;

      allow delete: if isSignedIn() && (
        existing().ownerUid == request.auth.uid ||
        isAdmin()
      );
    }

    match /messageRequests/{requestId} {
      allow read: if isSignedIn() && (
        existing().fromUid == request.auth.uid ||
        existing().toUid == request.auth.uid ||
        isAdmin()
      );

      allow create: if isSignedIn() &&
        incoming().fromUid == request.auth.uid &&
        incoming().toUid != request.auth.uid &&
        incoming().status == 'pending' &&
        messageAllowMode(incoming().toUid) != 'nobody' &&
        !hasMessageBlock(
          incoming().fromUid,
          incoming().toUid
        );

      allow update: if isSignedIn() && (
          existing().toUid == request.auth.uid ||
          isAdmin()
        ) &&
        incoming().fromUid == existing().fromUid &&
        incoming().toUid == existing().toUid &&
        incoming().status in [
          'pending',
          'approved',
          'declined'
        ];

      allow delete: if isSignedIn() && (
        existing().fromUid == request.auth.uid ||
        existing().toUid == request.auth.uid ||
        isAdmin()
      );
    }

    match /chatRooms/{roomId} {
      allow read: if isSignedIn() && (
        request.auth.uid in existing().participants ||
        isAdmin()
      );

      allow create: if isSignedIn() &&
        isTwoPersonRoom(incoming()) &&
        request.auth.uid in incoming().participants &&
        incoming().get('conversationApproved', false) == true &&
        !hasMessageBlock(
          incoming().participants[0],
          incoming().participants[1]
        ) &&
        canActivateRoom(incoming());

      allow update: if isSignedIn() &&
        request.auth.uid in existing().participants &&
        incoming().participants == existing().participants &&
        (
          incoming().get('conversationApproved', false) == false ||
          (
            existing().get('conversationApproved', false) == true &&
            incoming().get('conversationApproved', false) == true &&
            !hasMessageBlock(
              incoming().participants[0],
              incoming().participants[1]
            )
          ) ||
          (
            existing().get('conversationApproved', false) == false &&
            incoming().get('conversationApproved', false) == true &&
            !hasMessageBlock(
              incoming().participants[0],
              incoming().participants[1]
            ) &&
            canActivateRoom(incoming())
          )
        );

      allow delete: if isSignedIn() && (
        request.auth.uid in existing().participants ||
        isAdmin()
      );
    }

    match /chatRooms/{roomId}/messages/{messageId} {
      allow read: if isSignedIn() && (
        request.auth.uid in get(
          /databases/$(database)/documents/chatRooms/$(roomId)
        ).data.participants ||
        isAdmin()
      );

      allow create: if isSignedIn() &&
        incoming().senderId == request.auth.uid &&
        incoming().roomId == roomId &&
        incoming().text is string &&
        incoming().text.size() > 0 &&
        incoming().text.size() <= 2000 &&
        request.auth.uid in get(
          /databases/$(database)/documents/chatRooms/$(roomId)
        ).data.participants &&
        get(
          /databases/$(database)/documents/chatRooms/$(roomId)
        ).data.get('conversationApproved', false) == true &&
        !hasMessageBlock(
          request.auth.uid,
          otherRoomParticipant(
            get(
              /databases/$(database)/documents/chatRooms/$(roomId)
            ).data
          )
        ) &&
        messageAllowMode(
          otherRoomParticipant(
            get(
              /databases/$(database)/documents/chatRooms/$(roomId)
            ).data
          )
        ) != 'nobody';

      allow delete: if isAdmin() || (
        isSignedIn() &&
        existing().senderId == request.auth.uid
      );
    }

    match /attendanceRecords/{recordId} {
      allow read: if isAdmin() || (
        isSignedIn() &&
        existing().memberId == request.auth.uid
      );

      allow create: if isSignedIn() &&
        incoming().memberId == request.auth.uid;

      allow update: if isAdmin() || (
        isSignedIn() &&
        existing().memberId == request.auth.uid &&
        incoming().memberId == request.auth.uid
      );

      allow delete: if isAdmin();
    }

    match /courses/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /enrollments/{id} {
      allow read: if isSignedIn() && (
        existing().userId == request.auth.uid ||
        isAdmin()
      );

      allow write: if isSignedIn() && (
        incoming().userId == request.auth.uid ||
        isAdmin()
      );
    }
  }
}
